{
  "name": "frank-claim-intake",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "npm run db:migrate && next dev",
    "build": "next build",
    "start": "next start",
    "test": "node --test",
    "db:seed": "node --env-file-if-exists=.env src/db/seed.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node --env-file-if-exists=.env src/db/migrate.ts",
    "db:studio": "node --env-file-if-exists=.env node_modules/drizzle-kit/bin.cjs studio",
    "typecheck": "tsc --noEmit",
    "fixtures:generate": "node fixtures/generate.ts",
    "model:smoke": "node --env-file-if-exists=.env src/model/smoke.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.6.0",
    "@electric-sql/pglite": "^0.6.0",
    "drizzle-orm": "^0.45.4",
    "next": "^16.4.6",
    "openai": "^7.53.0",
    "postgres": "^4.1.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "unpdf": "^2.1.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@electric-sql/pglite-socket": "^0.3.0",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "drizzle-kit": "^0.31.11",
    "pdf-lib": "^1.17.1",
    "typescript": "^7.0.2"
  }
}
