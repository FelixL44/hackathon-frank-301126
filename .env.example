# Copy to .env (never commit .env). Everything is optional: without values the app runs on PGlite with fixture data.

# Database: any Postgres. Unset → embedded PGlite in .data/pglite
# DATABASE_URL=postgresql://postgres.<ref>:<password>@aws-0-eu-west-3.pooler.supabase.com:5432/postgres

# Model: pick ONE block. Unset MODEL_PROVIDER → fixture data, no model calls.
# MODEL_PROVIDER=anthropic
# MODEL_ID=claude-opus-5-5
# ANTHROPIC_API_KEY=

# MODEL_PROVIDER=openai
# MODEL_ID=gpt-5.5
# OPENAI_API_KEY=
# MODEL_PRICE_USD_PER_MTOK=<input>,<output>   # required for openai: copy from OpenAI's pricing page

# MODEL_PROVIDER=openai-compatible
# MODEL_ID=qwen2.5vl
# MODEL_BASE_URL=http://localhost:11434/v1

# Daily model budget in EUR (default 1). When reached, new cases use fixture data.
# MODEL_DAILY_BUDGET_EUR=1

# Language of drafted customer messages: en (default) or pt
# APP_LANGUAGE=en

# Admin workspace password (default for the demo: frank-admin). Change it for any public deployment.
# ADMIN_PASSWORD=frank-admin

# Signs customer sessions. Unset → derived from ADMIN_PASSWORD.
# SESSION_SECRET=

# WhatsApp Business (Meta Cloud API) and Telegram. Unset → confirmed messages stay in the web inbox.
# Also editable in the admin view, which wins over these values.
# WHATSAPP_ACCESS_TOKEN=
# WHATSAPP_PHONE_NUMBER_ID=
# WHATSAPP_VERIFY_TOKEN=
# WHATSAPP_BUSINESS_NAME=FRANK Broker
# WHATSAPP_NUMBER=
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_BOT_NAME=
